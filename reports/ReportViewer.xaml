<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WorkTime Report Viewer"
    Height="780" Width="1280"
    WindowStartupLocation="CenterScreen"
    Background="#0f172a"
    FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
    FontSize="13"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- ベース (背景・枠線・文字色) は 3 画面共通のスレート系。
             画面を見分けるアクセントだけ青にする (日次入力 / WBS 入力は緑、管理者は赤紫) -->
        <SolidColorBrush x:Key="Bg"        Color="#f8fafc"/>
        <SolidColorBrush x:Key="Surface"   Color="#ffffff"/>
        <SolidColorBrush x:Key="Surface2"  Color="#f1f5f9"/>
        <SolidColorBrush x:Key="Border"    Color="#cbd5e1"/>
        <SolidColorBrush x:Key="Text"      Color="#0f172a"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748b"/>
        <SolidColorBrush x:Key="SkyD"      Color="#075985"/>
        <SolidColorBrush x:Key="SkyDark"   Color="#0c4a6e"/>
        <SolidColorBrush x:Key="SkyL"      Color="#7dd3fc"/>
        <SolidColorBrush x:Key="Soft"      Color="#e0f2fe"/>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
        </Style>

        <!-- ボタンの寸法・角丸・文字サイズは 3 画面で共通 (日次入力 / WBS 入力と同値) -->
        <!-- ボタンアイコン用 (Segoe MDL2 Assets)。絵文字は環境によって色付き/モノクロが
             混在するため、アイコンとして使う箇所はこのグリフフォントに統一する -->
        <!-- ヘッダー/フッターの濃色地に置くボタン (すりガラス調チップ)。
             アクション種別による色分けは行わず、全ボタンをこの単一スタイルに統一する
             (2026-08-22 ユーザー要望: macOS の Toolbar/Vibrancy 材質を参考)。

             寸法・余白をこのスタイル側で完結させている理由:
             既定 Button スタイル (Margin=2 / Padding=12,5 / FontWeight=SemiBold) を
             継承したままだと、隣接ボタンの枠線どうしが接触して 1 つの塊に見え、
             文字も枠に詰まって「線画のワイヤーフレーム」のような見た目になっていた。
             チップ同士を確実に離すため Margin を左右 3 に固定し、
             各ボタン側の個別 Margin 指定は撤去してある (再指定するとまた不揃いになる)。

             塗り (Background) を 22% まで上げているのは、8% では地と区別がつかず
             枠線だけが浮いて見えたため。枠線 35% はヘッダー背景 #0f172a に対し
             WCAG 1.4.11 (非テキストコントラスト 3:1 以上) を満たす下限値 (実測 3.20:1)。
             塗りだけでは 2.01:1 しか出ないので、枠線側で基準を担保している -->
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#38FFFFFF"/>
            <Setter Property="Foreground" Value="#f1f5f9"/>
            <Setter Property="BorderBrush" Value="#59FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4DFFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#73FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#66FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#8CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#30FFFFFF"/>
                                <Setter Property="Foreground" Value="#7c8798"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- ボタン内のラベル文字。Foreground を持たないのが肝で、キー付きスタイルを
             当てることで暗黙の <Style TargetType="TextBlock"> (Foreground=濃色) を
             回避し、親 Button の Foreground を継承させる。
             これを付け忘れると、濃色チップの上に濃色の文字が乗って読めなくなる
             (アイコンはキー付きの IconGlyph を使っていて暗黙スタイルの影響を
             受けないため、アイコンだけ明るく文字だけ暗い、という形で露見した) -->
        <Style x:Key="BtnLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#e2e8f0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#cbd5e1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#f1f5f9"/>
                                <Setter Property="Foreground" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Margin="2,0" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource SkyD}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ヘッダ (ディープスレート) -->
        <!-- ヘッダの並びは 3 画面共通:
             左 = 画面名 + 状態 / 中央右 = データ取得 (読込・取得) / 右端 = 画面切替 + 管理 -->
        <Border DockPanel.Dock="Top" Background="#0f172a" Padding="18,12">
            <DockPanel>
                <!-- 右端: 画面切り替え & 管理 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TrackerNavBtn" Style="{StaticResource HeaderButton}" ToolTip="日次入力画面を開く">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE121;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="日次入力" Style="{StaticResource BtnLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="WbsNavBtn" Style="{StaticResource HeaderButton}" ToolTip="WBS入力画面を開く">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="WBS入力" Style="{StaticResource BtnLabel}"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="6,4" Background="#334155" VerticalAlignment="Stretch"/>
                    <Button x:Name="AdminBtn" Visibility="Collapsed" Style="{StaticResource HeaderButton}"
                            ToolTip="マスタ編集 / 他者データ編集">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="管理者" Style="{StaticResource BtnLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 中央右: データ取得 (Tracker / WBS 入力と同じ位置・同じ配色) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button x:Name="LoadAllBtn" Style="{StaticResource HeaderButton}"
                            ToolTip="ローカルから全データ再読込">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA37;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="読込" Style="{StaticResource BtnLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReloadBtn" Style="{StaticResource HeaderButton}"
                            ToolTip="Gitlab からマスタ + 全データ取得 → ローカルから読込">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="取得" Style="{StaticResource BtnLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 左: 画面名 + 集計サマリ (長い場合は "…" で省略) -->
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Text="📊 WorkTime Report" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SummaryText" Foreground="#38bdf8" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="RemoteNoticeText" Foreground="#fef08a" FontWeight="Bold" Visibility="Collapsed"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- フッタ (ディープスレート) -->
        <!-- フッタの並びも 3 画面共通: 左 = 保存先/状態 (長ければ省略) / 右 = バージョン + その画面の主アクション -->
        <Border DockPanel.Dock="Bottom" Background="#0f172a" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock Grid.Column="1" x:Name="VersionText" Margin="14,0,12,0" Foreground="#38bdf8" FontSize="11" VerticalAlignment="Center"
                           Cursor="Hand" TextDecorations="Underline"
                           ToolTip="クリックで変更履歴 (CHANGELOG) を表示"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ApplyBtn" Style="{StaticResource HeaderButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71C;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="フィルタ適用" Style="{StaticResource BtnLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportBtn" Style="{StaticResource HeaderButton}" MinWidth="150">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="CSV エクスポート" Style="{StaticResource BtnLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 期間フィルタ + クイック選択 + 集計軸フィルタ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <!-- ラベルと入力を 1 セット (StackPanel) にして WrapPanel へ入れる。
                 こうしないと折り返し位置によってラベルだけ前の行に残り、対応関係が読めなくなる -->
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                    <Label Content="期間:"/>
                    <DatePicker x:Name="FromDate" Width="140" Margin="4,0,0,0"/>
                    <Label Content="〜" Margin="6,0"/>
                    <DatePicker x:Name="ToDate" Width="140"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                    <Button x:Name="PeriodThisMonthBtn" Padding="10,2" ToolTip="今月の 1 日 〜 月末">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="当月" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PeriodPrevMonthBtn" Padding="10,2" ToolTip="先月の 1 日 〜 月末">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="前月" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PeriodThisFYBtn" Padding="10,2" ToolTip="4 月 1 日 〜 翌 3 月末 (会計年度)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="今年度" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                    <Label Content="会社:"/>
                    <ComboBox x:Name="CompanyFilter" MinWidth="160" Margin="4,0,0,0"
                              DisplayMemberPath="display" SelectedValuePath="key"
                              ToolTip="(全会社) で絞り込み解除。選択するとメンバー一覧もその会社に絞られる"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                    <Label Content="メンバー:"/>
                    <ComboBox x:Name="MemberFilter" MinWidth="200" Margin="4,0,0,0"
                              DisplayMemberPath="display" SelectedValuePath="id"
                              ToolTip="(全メンバー) で絞り込み解除"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                    <Label Content="システム:"/>
                    <ComboBox x:Name="SystemFilter" MinWidth="180" Margin="4,0,0,0"
                              DisplayMemberPath="display" SelectedValuePath="key"
                              ToolTip="(全システム) で絞り込み解除"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                    <Label Content="業務種別:"/>
                    <ComboBox x:Name="WorkTypeFilter" MinWidth="140" Margin="4,0,0,0"
                              DisplayMemberPath="display" SelectedValuePath="key"
                              ToolTip="(全業務種別) で絞り込み解除"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <Label Content="プロジェクト:"/>
                    <ComboBox x:Name="ProjectFilter" MinWidth="220" Margin="4,0,0,0"
                              DisplayMemberPath="display" SelectedValuePath="key"
                              ToolTip="(全プロジェクト) で絞り込み解除"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 本体: タブ -->
        <Border Style="{StaticResource Card}">
            <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
                <TabItem x:Name="GrpOverview" Header="📊 概要">
                    <TabControl x:Name="GrpOverviewInner" Background="Transparent" BorderThickness="0">
                        <TabItem Header="📊 ダッシュボード">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DashboardPanel" Margin="14"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="📉 グラフ">
                            <DockPanel Margin="10">
                                <Border DockPanel.Dock="Top" Background="{StaticResource Surface2}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="集計軸:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ChartAxisCombo" MinWidth="160" Margin="6,0">
                                            <ComboBoxItem Content="プロジェクト" IsSelected="True"/>
                                            <ComboBoxItem Content="工程"/>
                                            <ComboBoxItem Content="タスクグループ"/>
                                            <ComboBoxItem Content="タスク"/>
                                            <ComboBoxItem Content="カテゴリ"/>
                                            <ComboBoxItem Content="メンバー"/>
                                            <ComboBoxItem Content="日付"/>
                                            <ComboBoxItem Content="曜日"/>
                                        </ComboBox>
                                        <Label Content="形式:" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                        <ComboBox x:Name="ChartTypeCombo" MinWidth="120" Margin="6,0">
                                            <ComboBoxItem Content="横棒" IsSelected="True"/>
                                            <ComboBoxItem Content="縦棒"/>
                                        </ComboBox>
                                        <Label Content="並び:" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                        <ComboBox x:Name="ChartSortCombo" MinWidth="120" Margin="6,0">
                                            <ComboBoxItem Content="工数 降順" IsSelected="True"/>
                                            <ComboBoxItem Content="工数 昇順"/>
                                            <ComboBoxItem Content="名前順"/>
                                        </ComboBox>
                                        <Label Content="上位:" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                        <ComboBox x:Name="ChartTopCombo" MinWidth="80" Margin="6,0">
                                            <ComboBoxItem Content="10" IsSelected="True"/>
                                            <ComboBoxItem Content="20"/>
                                            <ComboBoxItem Content="50"/>
                                            <ComboBoxItem Content="全件"/>
                                        </ComboBox>
                                        <Button x:Name="ChartRedrawBtn" Margin="14,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE895;" Style="{StaticResource IconGlyph}"/>
                                                <TextBlock Text="再描画" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Surface}" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <Canvas x:Name="ChartCanvas" Background="{StaticResource Surface}" Width="800" Height="500"/>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="📈 分析">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="AnalysisPanel" Margin="10"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem x:Name="GrpMember" Header="👥 メンバー">
                    <TabControl x:Name="GrpMemberInner" Background="Transparent" BorderThickness="0">
                        <TabItem Header="👥 メンバー別">
                            <DataGrid x:Name="MemberSummaryGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column"
                                      Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}"
                                      AlternatingRowBackground="#f0f9ff" GridLinesVisibility="None"
                                      BorderBrush="{StaticResource Border}" BorderThickness="1"
                                      RowHeight="32" ColumnHeaderHeight="38">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource Soft}"/>
                                        <Setter Property="Foreground" Value="{StaticResource SkyD}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,4"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </TabItem>
        <TabItem Header="👥 負荷">
            <DockPanel Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="週次稼働 / 長時間労働警告"
                           FontWeight="Bold" Foreground="{StaticResource SkyD}" Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Label Content="長時間労働しきい値(週):" VerticalAlignment="Center"/>
                    <TextBox x:Name="LoadOverThresholdTxt" Width="60" Text="45" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <Label Content="目標(週):" VerticalAlignment="Center"/>
                    <TextBox x:Name="LoadTargetTxt" Width="60" Text="40" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <Button x:Name="LoadRefreshBtn" Padding="8,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="再計算" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="▼ メンバー × 週 稼働マトリクス (赤=しきい値超 / 黄=未入力日あり)"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DataGrid x:Name="LoadWeeklyGrid" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" RowHeight="26"
                              Background="White" RowBackground="White"
                              AlternatingRowBackground="#fef3c7"
                              BorderBrush="{StaticResource Border}" BorderThickness="1"
                              HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </DockPanel>
        </TabItem>
                        <TabItem Header="🔀 メンバー×PJ">
                            <DockPanel Margin="10">
                                <TextBlock DockPanel.Dock="Top" Text="メンバー × プロジェクト 工数マトリクス (空セル = 関与なし)"
                                           FontWeight="Bold" Foreground="{StaticResource SkyD}" Margin="0,0,0,8"/>
                                <DataGrid x:Name="MemberProjectGrid" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                          HeadersVisibility="Column" RowHeight="26"
                                          Background="White" RowBackground="White"
                                          AlternatingRowBackground="#e0f2fe"
                                          BorderBrush="{StaticResource Border}" BorderThickness="1"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="🏢 会社別">
                            <DataGrid x:Name="CompanySummaryGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column"
                                      Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}"
                                      AlternatingRowBackground="#fef3c7" GridLinesVisibility="None"
                                      BorderBrush="{StaticResource Border}" BorderThickness="1"
                                      RowHeight="32" ColumnHeaderHeight="38">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource Soft}"/>
                                        <Setter Property="Foreground" Value="{StaticResource SkyD}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,4"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem x:Name="GrpProject" Header="📁 案件・PJ">
                    <TabControl x:Name="GrpProjectInner" Background="Transparent" BorderThickness="0">
                        <TabItem Header="📁 プロジェクト別">
                            <DataGrid x:Name="ProjectSummaryGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column"
                                      Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}"
                                      AlternatingRowBackground="#f0f9ff" GridLinesVisibility="None"
                                      BorderBrush="{StaticResource Border}" BorderThickness="1"
                                      RowHeight="32" ColumnHeaderHeight="38">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource Soft}"/>
                                        <Setter Property="Foreground" Value="{StaticResource SkyD}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,4"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="🖥 システム別">
                            <DataGrid x:Name="SystemSummaryGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column"
                                      Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}"
                                      AlternatingRowBackground="#e0f2fe" GridLinesVisibility="None"
                                      BorderBrush="{StaticResource Border}" BorderThickness="1"
                                      RowHeight="32" ColumnHeaderHeight="38">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource Soft}"/>
                                        <Setter Property="Foreground" Value="{StaticResource SkyD}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,4"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="💼 業務種別比率">
                            <DockPanel Margin="10">
                                <TextBlock DockPanel.Dock="Top" Text="業務種別 (案件対応 / 維持運用 / その他) の稼働比率"
                                           FontWeight="Bold" Foreground="{StaticResource SkyD}" Margin="0,0,0,8"/>
                                <!-- タブ内専用フィルタは廃止 (上部の共通フィルタと判定が同一で、
                                     共通フィルタの結果をさらに絞るだけの二重適用だった)。
                                     共通の業務種別フィルタが効いていると比率が一色になるため、
                                     その場合だけ注意書きを出す。 -->
                                <Border x:Name="WorkTypeNoteBox" DockPanel.Dock="Top" Background="#fef3c7" CornerRadius="8"
                                        BorderBrush="#fbbf24" BorderThickness="1" Padding="10" Margin="0,0,0,8"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="WorkTypeNoteText" TextWrapping="Wrap" Foreground="#92400e"/>
                                </Border>
                                <TabControl>
                                    <TabItem Header="📊 概要">
                                        <Grid Margin="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="{StaticResource Surface2}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel x:Name="WorkTypeKpiPanel" Orientation="Horizontal"/>
                                            </Border>
                                            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Canvas x:Name="WorkTypePieCanvas" Width="220" Height="220" Background="White"/>
                                                    <StackPanel x:Name="WorkTypePieLegend" Orientation="Vertical" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <DataGrid Grid.Row="2" x:Name="WorkTypeByMemberGrid" AutoGenerateColumns="False"
                                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                                      HeadersVisibility="Column" RowHeight="26"
                                                      Background="White" RowBackground="White"
                                                      AlternatingRowBackground="#f0fdf4"
                                                      BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                      HorizontalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="📁 案件対応 分析">
                                        <DockPanel Margin="6">
                                            <Border DockPanel.Dock="Top" Background="{StaticResource Surface2}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Label Content="集計軸:" VerticalAlignment="Center"/>
                                                    <ComboBox x:Name="CaseAxisCombo" MinWidth="160" Margin="6,0">
                                                        <ComboBoxItem Content="工程" IsSelected="True"/>
                                                        <ComboBoxItem Content="タスクグループ"/>
                                                        <ComboBoxItem Content="タスク"/>
                                                    </ComboBox>
                                                    <TextBlock VerticalAlignment="Center" Margin="14,0,0,0"
                                                               Foreground="Gray" FontSize="11"
                                                               Text="行 = プロジェクト / 列 = 選択軸 (案件対応のみ)"/>
                                                </StackPanel>
                                            </Border>
                                            <Border DockPanel.Dock="Top" Background="White" CornerRadius="8"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                    Padding="10" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                                                        <TextBlock Text="🥧 軸別 工数比率" FontWeight="Bold" Foreground="{StaticResource SkyD}" Margin="0,0,0,4"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Canvas x:Name="CasePieCanvas" Width="200" Height="200" Background="White"/>
                                                            <StackPanel x:Name="CasePieLegend" Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock Text="📊 月別工数 (積上 = 軸別内訳)" FontWeight="Bold" Foreground="{StaticResource SkyD}" Margin="0,0,0,4"/>
                                                        <Canvas x:Name="CaseBarCanvas" Width="600" Height="200" Background="White"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <DataGrid x:Name="CaseAnalysisGrid" AutoGenerateColumns="False"
                                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                                      HeadersVisibility="Column" RowHeight="26"
                                                      Background="White" RowBackground="White"
                                                      AlternatingRowBackground="#dbeafe"
                                                      BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                                        </DockPanel>
                                    </TabItem>
                                    <TabItem Header="🖥 維持運用 分析">
                                        <DockPanel Margin="6">
                                            <Border DockPanel.Dock="Top" Background="{StaticResource Surface2}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Label Content="集計軸:" VerticalAlignment="Center"/>
                                                    <ComboBox x:Name="OpsAxisCombo" MinWidth="160" Margin="6,0">
                                                        <ComboBoxItem Content="工程" IsSelected="True"/>
                                                        <ComboBoxItem Content="タスクグループ"/>
                                                        <ComboBoxItem Content="タスク"/>
                                                    </ComboBox>
                                                    <TextBlock VerticalAlignment="Center" Margin="14,0,0,0"
                                                               Foreground="Gray" FontSize="11"
                                                               Text="行 = 対象システム / 列 = 選択軸 (維持運用のみ)"/>
                                                </StackPanel>
                                            </Border>
                                            <Border DockPanel.Dock="Top" Background="White" CornerRadius="8"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                    Padding="10" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                                                        <TextBlock Text="🥧 軸別 工数比率" FontWeight="Bold" Foreground="{StaticResource SkyD}" Margin="0,0,0,4"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Canvas x:Name="OpsPieCanvas" Width="200" Height="200" Background="White"/>
                                                            <StackPanel x:Name="OpsPieLegend" Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock Text="📊 月別工数 (積上 = 軸別内訳)" FontWeight="Bold" Foreground="{StaticResource SkyD}" Margin="0,0,0,4"/>
                                                        <Canvas x:Name="OpsBarCanvas" Width="600" Height="200" Background="White"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <DataGrid x:Name="OpsAnalysisGrid" AutoGenerateColumns="False"
                                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                                      HeadersVisibility="Column" RowHeight="26"
                                                      Background="White" RowBackground="White"
                                                      AlternatingRowBackground="#dcfce7"
                                                      BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                                        </DockPanel>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="🏷 カテゴリ別">
                            <DataGrid x:Name="CategorySummaryGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column"
                                      Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}"
                                      AlternatingRowBackground="#f0f9ff" GridLinesVisibility="None"
                                      BorderBrush="{StaticResource Border}" BorderThickness="1"
                                      RowHeight="32" ColumnHeaderHeight="38">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource Soft}"/>
                                        <Setter Property="Foreground" Value="{StaticResource SkyD}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,4"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem x:Name="GrpCheck" Header="⚠ チェック">
                    <TabControl x:Name="GrpCheckInner" Background="Transparent" BorderThickness="0">
                        <TabItem Header="⚠ 異常検知">
                            <DockPanel Margin="10">
                                <TextBlock DockPanel.Dock="Top" Text="閾値超過 / 過負荷 / 入力漏れ候補"
                                           FontWeight="Bold" Foreground="{StaticResource SkyD}" Margin="0,0,0,8"/>
                                <DataGrid x:Name="AnomalyGrid" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" RowHeight="32"
                                          Background="White" RowBackground="White"
                                          AlternatingRowBackground="#fef2f2"
                                          BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="種別"     Binding="{Binding kind}"    Width="120" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="対象"     Binding="{Binding target}"  Width="240" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="工数(h)"  Binding="{Binding hours}"   Width="80"  IsReadOnly="True"/>
                                        <DataGridTextColumn Header="メッセージ" Binding="{Binding message}" Width="*"  IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
        <TabItem x:Name="MissingTab" Header="🕳 未入力">
            <DockPanel Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="未入力検知 (平日 × メンバー で入力 0h の日)"
                           FontWeight="Bold" Foreground="{StaticResource SkyD}" Margin="0,0,0,8"/>
                <DataGrid x:Name="MissingEntriesGrid" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" RowHeight="26"
                          Background="White" RowBackground="White"
                          AlternatingRowBackground="#fee2e2"
                          BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="メンバー" Binding="{Binding member}" Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="日数"     Binding="{Binding missing_count}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="未入力日付 (最大 10 件)" Binding="{Binding missing_dates}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
                        <TabItem Header="🔥 ヒートマップ">
                            <DockPanel Margin="10">
                                <Border DockPanel.Dock="Top" Background="{StaticResource Surface2}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="軸:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="HeatmapAxisCombo" MinWidth="220" Margin="6,0">
                                            <ComboBoxItem Content="日付 × プロジェクト" IsSelected="True"/>
                                            <ComboBoxItem Content="日付 × メンバー (個人別)"/>
                                            <ComboBoxItem Content="メンバー × プロジェクト"/>
                                        </ComboBox>
                                        <TextBlock x:Name="HeatmapDescText" VerticalAlignment="Center" Margin="14,0,0,0"
                                                   Foreground="Gray" FontSize="11"
                                                   Text="色濃度 = 工数 / hover でセル値"/>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Canvas x:Name="HeatmapCanvas" Background="White" Width="1200" Height="600"/>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem x:Name="GrpDetail" Header="📋 明細">
                    <TabControl x:Name="GrpDetailInner" Background="Transparent" BorderThickness="0">
                        <TabItem Header="📋 明細">
                            <!-- 0 件のときは白紙にせず、フィルタを緩める案内を出す -->
                            <Grid>
                            <TextBlock x:Name="EmptyDetailText" Panel.ZIndex="1"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="24,60,24,0"
                                       FontSize="13" Foreground="{StaticResource TextMuted}"
                                       Text="条件に一致する実績がありません。&#x0a;期間を広げるか、上のフィルタを (全メンバー) などに戻してください。"/>
                            <DataGrid x:Name="DetailGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      Background="{StaticResource Surface}"
                                      RowBackground="{StaticResource Surface}"
                                      AlternatingRowBackground="#f0f9ff"
                                      GridLinesVisibility="None"
                                      BorderBrush="{StaticResource Border}"
                                      BorderThickness="1"
                                      RowHeight="32"
                                      ColumnHeaderHeight="38">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource Soft}"/>
                                        <Setter Property="Foreground" Value="{StaticResource SkyD}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,4"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="日付" Binding="{Binding date}" Width="100"/>
                                    <DataGridTextColumn Header="メンバー" Binding="{Binding member_display}" Width="150"/>
                                    <DataGridTextColumn Header="プロジェクト" Binding="{Binding project_display}" Width="180"/>
                                    <DataGridTextColumn Header="工程" Binding="{Binding process_display}" Width="130"/>
                                    <DataGridTextColumn Header="ﾀｽｸｸﾞﾙｰﾌﾟ" Binding="{Binding task_group_display}" Width="150"/>
                                    <DataGridTextColumn Header="タスク" Binding="{Binding task_display}" Width="150"/>
                                    <DataGridTextColumn Header="カテゴリ" Binding="{Binding category_display}" Width="130"/>
                                    <DataGridTextColumn Header="工数" Binding="{Binding hours, StringFormat=N1}" Width="70"/>
                                    <DataGridTextColumn Header="コメント" Binding="{Binding comment}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </Border>
    </DockPanel>
</Window>
