<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="初回設定 - WorkTime Tracker"
    Height="730" Width="640"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="#f8fafc"
    FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
    FontSize="13"
    TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#ffffff"/>
        <SolidColorBrush x:Key="Border"  Color="#cbd5e1"/>
        <SolidColorBrush x:Key="Text"    Color="#0f172a"/>
        <SolidColorBrush x:Key="Muted"   Color="#64748b"/>
        <SolidColorBrush x:Key="Emerald" Color="#047857"/>
        <SolidColorBrush x:Key="EmeraldD" Color="#065f46"/>
        <SolidColorBrush x:Key="Soft"    Color="#d1fae5"/>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
        </Style>
        <!-- ボタンアイコン用 (Segoe MDL2 Assets)。絵文字は環境によって色付き/モノクロが
             混在するため、アイコンとして使う箇所はこのグリフフォントに統一する -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#ecfdf5"/>
            <Setter Property="Foreground" Value="{StaticResource EmeraldD}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#d1fae5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Background="#064e3b" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="⚙ 接続設定" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="保存先と同期方法を設定します" FontSize="11" Foreground="#a7f3d0" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="TestBtn">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE701;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="接続テスト" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CancelBtn">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="キャンセル" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="SaveBtn" MinWidth="160">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="保存して開始" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="保存先モード:"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ModeCombo">
                <ComboBoxItem Tag="local"  Content="スタンドアローン (ローカルのみ)" IsSelected="True"/>
                <ComboBoxItem Tag="gitlab" Content="Gitlab モード (ローカル保管 + 送信ボタンで Gitlab に同期)"/>
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11"
                       Text="保存ボタン: 常にローカルへ。送信ボタン: Gitlab へ push (Gitlab モード時のみ)。"/>

            <!-- ローカル保管先 (全モード共通・必須) -->
            <Label Grid.Row="2" Grid.Column="0" Content="ローカル保管先:"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="LocalRootBox"/>
            <Button Grid.Row="2" Grid.Column="2" x:Name="BrowseBtn">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE838;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="参照…" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11"
                       Text="master/ と data/ をここに保管 (デフォルト %LOCALAPPDATA%\worktime-tracker\store)"/>

            <!-- GitLab 専用 -->
            <Label Grid.Row="4" Grid.Column="0" x:Name="UrlLabel" Content="GitLab URL:"/>
            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="UrlBox"/>

            <Label Grid.Row="5" Grid.Column="0" x:Name="ProjectIdLabel" Content="Project ID / Path:"/>
            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProjectIdBox"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProjectIdHint" FontSize="11"
                       Text='数値 ID または "owner/repo" 形式'/>

            <Label Grid.Row="7" Grid.Column="0" x:Name="BranchLabel" Content="ブランチ:"/>
            <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" x:Name="BranchBox" Text="main"/>

            <Label Grid.Row="8" Grid.Column="0" x:Name="TokenLabel" Content="Access Token:"/>
            <PasswordBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TokenBox"/>
            <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TokenHint" FontSize="11"
                       Text="GitLab Project Access Token / GitHub PAT (DPAPI 暗号化で保管)"/>

            <Label Grid.Row="11" Grid.Column="0" Content="あなたの Member ID:"/>
            <TextBox Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" x:Name="MemberIdBox"/>
            <TextBlock Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11"
                       Text="master/members.json の id (空なら Windows ログイン名で補完)"/>

            <!-- ログ出力先 (全モード共通・任意) -->
            <Label Grid.Row="13" Grid.Column="0" Content="ログ出力先:"/>
            <TextBox Grid.Row="13" Grid.Column="1" x:Name="LogDirBox"/>
            <Button Grid.Row="13" Grid.Column="2" x:Name="BrowseLogBtn">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE838;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="参照…" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11"
                       Text="ブランクのとき出力なし (last_error.log / report_trace.log)"/>

            <TextBlock Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="3" x:Name="StatusText" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"/>
        </Grid>
        </Border>
    </DockPanel>
</Window>
