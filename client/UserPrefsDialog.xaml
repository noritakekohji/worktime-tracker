<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="個人設定 - WorkTime Tracker"
    Height="600" Width="640"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="#f8fafc"
    FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
    FontSize="13"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg"        Color="#f8fafc"/>
        <SolidColorBrush x:Key="Surface"   Color="#ffffff"/>
        <SolidColorBrush x:Key="Surface2"  Color="#f1f5f9"/>
        <SolidColorBrush x:Key="Border"    Color="#cbd5e1"/>
        <SolidColorBrush x:Key="Text"      Color="#0f172a"/>
        <SolidColorBrush x:Key="Muted"     Color="#64748b"/>
        <SolidColorBrush x:Key="Emerald"   Color="#047857"/>
        <SolidColorBrush x:Key="EmeraldD"  Color="#065f46"/>
        <SolidColorBrush x:Key="EmeraldL"  Color="#a7f3d0"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <!-- ボタンアイコン用 (Segoe MDL2 Assets)。絵文字は環境によって色付き/モノクロが
             混在するため、アイコンとして使う箇所はこのグリフフォントに統一する -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource EmeraldD}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#d1fae5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource EmeraldL}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#f3f4f6"/>
                                <Setter Property="Foreground" Value="#9ca3af"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Background="#064e3b" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="⭐ 個人設定" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="MemberLabel" Text="" Margin="0,6,0,0" Foreground="#a7f3d0"/>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelBtn">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="キャンセル" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="SaveBtn" MinWidth="120">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="保存" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="お気に入りプロジェクトを選択してください。選択したプロジェクトはプロジェクト一覧の先頭に表示されます。"
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProjectsList" Margin="2"/>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
