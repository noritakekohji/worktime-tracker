<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WBS 実績入力 - WorkTime Tracker"
    Height="750" Width="1300"
    MinHeight="500" MinWidth="920"
    WindowStartupLocation="CenterScreen"
    Background="#f8fafc"
    FontFamily="Meiryo UI, Yu Gothic UI, Segoe UI"
    FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Emerald"  Color="#047857"/>
        <SolidColorBrush x:Key="EmeraldD" Color="#065f46"/>
        <SolidColorBrush x:Key="Bg"       Color="#f8fafc"/>
        <SolidColorBrush x:Key="Surface"  Color="#ffffff"/>
        <SolidColorBrush x:Key="Surface2" Color="#f1f5f9"/>
        <SolidColorBrush x:Key="Border"   Color="#cbd5e1"/>
        <SolidColorBrush x:Key="Text"     Color="#0f172a"/>
        <SolidColorBrush x:Key="Muted"    Color="#64748b"/>
        <SolidColorBrush x:Key="Soft"     Color="#ecfdf5"/>
        <SolidColorBrush x:Key="Weekend"  Color="#b45309"/>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,4,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#e2e8f0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Emerald}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{StaticResource Emerald}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource EmeraldD}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== ヘッダバー (ディープスレート) ===== -->
        <Border DockPanel.Dock="Top" Background="#0f172a" Padding="18,12">
            <DockPanel>
                <!-- 右端: ナビゲーションボタン -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TrackerNavBtn" Content="⏱ 日次入力" Margin="0,0,4,0" Background="#1e293b" Foreground="#34d399" BorderBrush="#334155" ToolTip="日次入力画面を開く"/>
                    <Button x:Name="ReportNavBtn" Content="📈 レポート" Margin="0,0,8,0" Background="#1e293b" Foreground="#38bdf8" BorderBrush="#334155" ToolTip="集計レポート画面を開く"/>
                    <Button x:Name="AdminBtn" Content="🛠 管理者" Margin="6,0,0,0" Visibility="Collapsed" Background="#334155" Foreground="White" BorderBrush="#475569"/>
                </StackPanel>

                <!-- 左側・中央: プロジェクト・年月・アクション -->
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="📊 WBS 実績入力" FontSize="17" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Label Content="プロジェクト:"/>
                    <ComboBox x:Name="ProjectCombo" Width="260" Margin="0,0,12,0"
                              DisplayMemberPath="display" Background="White"
                              IsEditable="True" IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              TextSearch.TextPath="display"/>
                    <Label Content="年:"/>
                    <ComboBox x:Name="YearCombo" Width="68" Margin="0,0,4,0" Background="White"/>
                    <Label Content="月:"/>
                    <ComboBox x:Name="MonthCombo" Width="52" Margin="0,0,12,0" Background="White"/>
                    <Button x:Name="LoadBtn"  Content="📋 読込" Background="#1e293b" Foreground="#e2e8f0" BorderBrush="#475569" Margin="4,0,0,0"
                            ToolTip="ローカルから読込のみ"/>
                    <Button x:Name="PullBtn"  Content="📥 取得" Background="#0369a1" Foreground="White" BorderBrush="#0284c7" Margin="4,0,0,0"
                            ToolTip="Gitlab からマスタ + 自分の当月実績を取得 → ローカルから読込"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ===== フッタ (ディープスレート) ===== -->
        <!-- フッタの並びは 3 画面共通: 左 = 状態 (長ければ省略) / 右 = バージョン + 主アクション -->
        <Border DockPanel.Dock="Bottom" Background="#0f172a" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="プロジェクトと月を選択して「読込」を押してください"
                               Foreground="#fef08a" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="RemoteNoticeText" Visibility="Collapsed" Foreground="#fef08a" FontWeight="Bold" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="VersionText"
                           Margin="12,0,12,0" VerticalAlignment="Center"
                           Foreground="#34d399" FontSize="11"
                           Cursor="Hand" TextDecorations="Underline"
                           ToolTip="クリックで変更履歴 (CHANGELOG) を表示"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ProgressBar x:Name="SyncProgress" Width="120" Height="12" Margin="8,0,4,0" VerticalAlignment="Center"
                                 Visibility="Collapsed" IsIndeterminate="True" Foreground="#34d399"/>
                    <Button x:Name="SaveBtn" Content="💾 保存" Style="{StaticResource Primary}" MinWidth="100"/>
                    <Button x:Name="PushBtn" Content="📤 送信" Style="{StaticResource Primary}"
                            MinWidth="100" Margin="6,2,3,2"
                            ToolTip="ローカル保存 + Gitlabへ送信 (gitlabモードのみ有効)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主領域 (3 ペイン Splitter 構成) ===== -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160" MaxWidth="420"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="380" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- 左ペイン: WBS 構成ツリー (親・子構造) -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📁 WBS 構成ツリー" FontWeight="Bold"
                               Foreground="{StaticResource EmeraldD}" Margin="0,0,0,8"/>
                    <Button DockPanel.Dock="Bottom" x:Name="AddRowBtn"
                            Content="＋ 選択タスクに行を追加" IsEnabled="False" Margin="0,8,0,0"
                            ToolTip="選択した工程/タスクグループに新規WBS項目を追加"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TreeView x:Name="WbsTree" ItemContainerStyle="{StaticResource TreeItemStyle}"
                                  Background="Transparent" BorderThickness="0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Border}" Cursor="SizeWE"/>

            <!-- 中央ペイン: WBS グリッド (タスクレベル 1 行 + 計画ガント) -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <!-- 計画に対する進捗。文字で描くと桁で幅が変わるため ProgressBar を使う -->
                        <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Visibility="Collapsed" Margin="12,0,0,0">
                            <ProgressBar x:Name="ProgressBarCtl" Width="120" Height="10" Minimum="0" Maximum="100"
                                         Foreground="{StaticResource Emerald}" Background="{StaticResource Surface2}"
                                         BorderBrush="{StaticResource Border}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProgressText" Margin="6,0,0,0" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource EmeraldD}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="GridTitle"
                                   Text="プロジェクトを選択して「読込」を押してください"
                                   FontWeight="Bold" Foreground="{StaticResource EmeraldD}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="DelRowBtn" Content="🗑 選択行を削除" IsEnabled="False" Padding="8,2" Margin="0,0,8,0"/>
                        <CheckBox x:Name="ShowDoneChk" Content="完了/中止も表示" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="FilterStatusText" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>

                    <!-- ガント＋数値入力用グリッド (列は PS 側で動的生成)。
                         0 件のときは白紙にせず、次にすべきことを案内する -->
                    <Grid>
                    <TextBlock x:Name="EmptyGridText" Panel.ZIndex="1"
                               Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="24,60,24,0"
                               FontSize="13" Foreground="{StaticResource Muted}"
                               Text="このプロジェクトの WBS 項目はまだありません。&#x0a;左のツリーで工程・タスクを選び［＋ 選択タスクに行を追加］を押してください。"/>
                    <DataGrid x:Name="WbsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}"
                              AlternatingRowBackground="#f8fafc"
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                              BorderBrush="{StaticResource Border}" BorderThickness="1"
                              RowHeight="30" ColumnHeaderHeight="34" FontSize="12"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                <Setter Property="Foreground" Value="{StaticResource EmeraldD}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <!-- セル: Template 自体を上書きして CurrentCell 枠線を完全除去 -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#064e3b"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <!-- 行全体: 選択時のみ薄緑背景。フォーカス枠は出さない -->
                            <Style TargetType="DataGridRow">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#bbf7d0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource Border}" Cursor="SizeWE"/>

            <!-- 右ペイン: 選択タスクの実績入力 (TaskView) -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="TaskViewHeader"
                               Text="📝 グリッドでタスクを選択してください"
                               FontWeight="Bold" Foreground="{StaticResource EmeraldD}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <!-- 入力フォーム (担当・コメントはリスト側で編集) -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource Surface2}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="日付:" Foreground="{StaticResource Muted}"/>
                                <DatePicker Grid.Column="1" x:Name="TaskEntryDate"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="カテゴリ:" Foreground="{StaticResource Muted}"/>
                                <ComboBox Grid.Column="1" x:Name="TaskEntryCategory"
                                          DisplayMemberPath="name" SelectedValuePath="code"
                                          IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="name"/>
                                <Label Grid.Column="2" Content="工数:" Margin="8,0,4,0" Foreground="{StaticResource Muted}"/>
                                <TextBox Grid.Column="3" x:Name="TaskEntryHours" TextAlignment="Right" Text="1.0"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="TaskEntryAddBtn" Content="＋ 追加" Style="{StaticResource Primary}" MinWidth="80"/>
                                <Button x:Name="TaskEntryDelBtn" Content="🗑 削除" Margin="6,2,0,2" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 既存エントリ一覧 -->
                    <DataGrid x:Name="TaskEntriesGrid"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}"
                              AlternatingRowBackground="#f8fafc"
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#e2e8f0" VerticalGridLinesBrush="#e2e8f0"
                              BorderBrush="{StaticResource Border}" BorderThickness="1"
                              RowHeight="28" ColumnHeaderHeight="32" FontSize="12"
                              SelectionMode="Single">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                <Setter Property="Foreground" Value="{StaticResource EmeraldD}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日付"     Binding="{Binding date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="86"/>
                            <DataGridTextColumn Header="カテゴリ" Binding="{Binding category_display, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="工数"     Binding="{Binding hours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}" Width="52"/>
                            <DataGridTextColumn Header="コメント" Binding="{Binding comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
