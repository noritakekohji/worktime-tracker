<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="🌸 管理者モード - マスタ編集"
    Height="760" Width="1200"
    WindowStartupLocation="CenterScreen"
    Background="#0f172a"
    FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
    FontSize="13"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg"        Color="#f8fafc"/>
        <SolidColorBrush x:Key="Surface"   Color="#ffffff"/>
        <SolidColorBrush x:Key="Surface2"  Color="#f1f5f9"/>
        <SolidColorBrush x:Key="Border"    Color="#cbd5e1"/>
        <SolidColorBrush x:Key="Text"      Color="#0f172a"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748b"/>
        <SolidColorBrush x:Key="Sakura"    Color="#be185d"/>
        <SolidColorBrush x:Key="SakuraD"   Color="#9d174d"/>
        <SolidColorBrush x:Key="SakuraL"   Color="#fce7f3"/>
        <SolidColorBrush x:Key="Soft"      Color="#f1f5f9"/>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- ボタンアイコン用 (Segoe MDL2 Assets)。絵文字は環境によって色付き/モノクロが
             混在するため、アイコンとして使う箇所はこのグリフフォントに統一する -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- ボタン内のラベル文字。Foreground を持たないのが肝で、キー付きスタイルを
             当てることで暗黙の <Style TargetType="TextBlock"> (Foreground=濃色) を
             回避し、親 Button の Foreground を継承させる。
             これを付け忘れると、濃色チップの上に濃色の文字が乗って読めなくなる
             (アイコンはキー付きの IconGlyph を使っていて暗黙スタイルの影響を
             受けないため、アイコンだけ明るく文字だけ暗い、という形で露見した) -->
        <Style x:Key="BtnLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- ヘッダー/フッターの濃色地に置くボタン (すりガラス調チップ)。
             アクション種別による色分けは行わず、全ボタンをこの単一スタイルに統一する
             (2026-08-22 ユーザー要望: macOS の Toolbar/Vibrancy 材質を参考)。

             寸法・余白をこのスタイル側で完結させている理由:
             既定 Button スタイル (Margin=2 / Padding=12,5 / FontWeight=SemiBold) を
             継承したままだと、隣接ボタンの枠線どうしが接触して 1 つの塊に見え、
             文字も枠に詰まって「線画のワイヤーフレーム」のような見た目になっていた。
             チップ同士を確実に離すため Margin を左右 3 に固定し、
             各ボタン側の個別 Margin 指定は撤去してある (再指定するとまた不揃いになる)。

             塗り (Background) を 22% まで上げているのは、8% では地と区別がつかず
             枠線だけが浮いて見えたため。枠線 35% はヘッダー背景 #0f172a に対し
             WCAG 1.4.11 (非テキストコントラスト 3:1 以上) を満たす下限値 (実測 3.20:1)。
             塗りだけでは 2.01:1 しか出ないので、枠線側で基準を担保している -->
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#38FFFFFF"/>
            <Setter Property="Foreground" Value="#f1f5f9"/>
            <Setter Property="BorderBrush" Value="#59FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4DFFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#73FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#66FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#8CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#30FFFFFF"/>
                                <Setter Property="Foreground" Value="#7c8798"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource SakuraD}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#e2e8f0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#cbd5e1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#f1f5f9"/>
                                <Setter Property="Foreground" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Margin="2,0" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource SakuraD}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0f172a" Padding="18,14">
            <DockPanel>
                <TextBlock Text="🌸 マスタ編集" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#94a3b8"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="ReloadBtn" Style="{StaticResource HeaderButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA37;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="再読込" Style="{StaticResource BtnLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#0f172a" Padding="18,14">
            <DockPanel>
                <TextBlock x:Name="EditNote" Text="編集内容は『保存』を押すまで反映されません" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="CloseBtn" Style="{StaticResource HeaderButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="閉じる" Style="{StaticResource BtnLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveBtn" Style="{StaticResource HeaderButton}" MinWidth="100"
                            ToolTip="ローカルにマスタを保存 (リモートへの送信は別ボタン)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="保存" Style="{StaticResource BtnLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SendBtn" Style="{StaticResource HeaderButton}" MinWidth="100"
                            ToolTip="ローカル保存 + Gitlab へ push (Gitlabモード時のみ有効)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="送信" Style="{StaticResource BtnLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <TabControl x:Name="MainTab" Background="Transparent" BorderThickness="0">
                <!-- ===== メンバー ===== -->
                <TabItem Header="👥 メンバー">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="MemAddBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="追加" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="MemDelBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="選択行を削除" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <DataGrid x:Name="MembersGrid"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}"
                                  AlternatingRowBackground="#f8fafc" GridLinesVisibility="None"
                                  BorderBrush="{StaticResource Border}" BorderThickness="1"
                                  RowHeight="34" ColumnHeaderHeight="38" FontSize="13">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource Soft}"/>
                                    <Setter Property="Foreground" Value="{StaticResource SakuraD}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,4"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"     Binding="{Binding id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                <DataGridTextColumn Header="氏名"   Binding="{Binding name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                                <DataGridTextColumn Header="会社"   Binding="{Binding company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="部署"   Binding="{Binding department, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                <DataGridTextColumn Header="ランク" Binding="{Binding rank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <DataGridCheckBoxColumn Header="admin" Binding="{Binding is_admin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <DataGridCheckBoxColumn Header="leader" Binding="{Binding is_leader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <DataGridCheckBoxColumn Header="member" Binding="{Binding is_member, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <DataGridCheckBoxColumn Header="有効" Binding="{Binding active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== プロジェクト ===== -->
                <TabItem Header="📁 プロジェクト">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="PrjAddBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="追加" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PrjDelBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="選択行を削除" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <DataGrid x:Name="ProjectsGrid"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}"
                                  AlternatingRowBackground="#f8fafc" GridLinesVisibility="None"
                                  BorderBrush="{StaticResource Border}" BorderThickness="1"
                                  RowHeight="34" ColumnHeaderHeight="38" FontSize="13">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource Soft}"/>
                                    <Setter Property="Foreground" Value="{StaticResource SakuraD}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,4"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ユニットコード" Binding="{Binding unit_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="案件名称" Binding="{Binding project_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                <DataGridTextColumn Header="ユニット名称" Binding="{Binding unit_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                <DataGridTextColumn Header="対象システム" Binding="{Binding target_system, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                <DataGridTextColumn Header="業務種別 (案件対応/維持運用/その他)" Binding="{Binding work_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                <DataGridTextColumn Header="期間 FROM (YYYY-MM-DD)" Binding="{Binding period_from, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                <DataGridTextColumn Header="期間 TO (YYYY-MM-DD)" Binding="{Binding period_to, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                <DataGridComboBoxColumn x:Name="ProjPatternCol"
                                                        Header="タスクパターン"
                                                        SelectedValueBinding="{Binding task_pattern_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectedValuePath="Id"
                                                        DisplayMemberPath="Display"
                                                        Width="200"/>
                                <DataGridCheckBoxColumn Header="有効" Binding="{Binding active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== タスクパターン ===== -->
                <TabItem Header="🧩 タスクパターン">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 左: パターン一覧 -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                            <DockPanel>
                                <TextBlock Text="パターン一覧" FontWeight="Bold" Foreground="{StaticResource SakuraD}" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="PatAddBtn">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                                            <TextBlock Text="追加" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PatCopyBtn" ToolTip="選択パターンをまるごと複製">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconGlyph}"/>
                                            <TextBlock Text="複製" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PatDelBtn">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}"/>
                                            <TextBlock Text="削除" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <ListBox x:Name="PatternsList"
                                         Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                         DisplayMemberPath="display"/>
                            </DockPanel>
                        </Border>
                        <!-- 中央: 階層ツリー -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,6,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock x:Name="PatHeader" Text="階層 (工程 > タスク分類1 > タスク分類2)" FontWeight="Bold" Foreground="{StaticResource SakuraD}"/>
                                </DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="PatNodeUpBtn"   Content="▲ 上へ"   IsEnabled="False" ToolTip="兄弟内で順序を上へ"/>
                                    <Button x:Name="PatNodeDownBtn" Content="▼ 下へ"   IsEnabled="False" ToolTip="兄弟内で順序を下へ"/>
                                    <Button x:Name="PatNodeAddSibBtn" IsEnabled="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                                            <TextBlock Text="兄弟を追加" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PatNodeAddBtn" IsEnabled="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                                            <TextBlock Text="子を追加" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PatNodeDelBtn" IsEnabled="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}"/>
                                            <TextBlock Text="削除" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TreeView x:Name="PatternTree"
                                          Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                          Foreground="{StaticResource Text}" FontSize="13"/>
                            </DockPanel>
                        </Border>
                        <!-- 右: 詳細編集 -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="PatDetailTitle" Text="左で選択してください" FontWeight="Bold" Foreground="{StaticResource SakuraD}" Margin="0,0,0,10"/>
                                <Label Content="種別:"/>
                                <TextBlock x:Name="PatKindText" Text="" FontWeight="Bold"/>
                                <Label Content="コード:" Margin="0,8,0,0"/>
                                <TextBox x:Name="PatCodeBox" IsEnabled="False"/>
                                <Label Content="名称:" Margin="0,4,0,0"/>
                                <TextBox x:Name="PatNameBox" IsEnabled="False"/>
                                <Label Content="説明 (Tracker 入力時に参照):" Margin="0,4,0,0"/>
                                <TextBox x:Name="PatDescBox" IsEnabled="False"
                                         Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                <TextBlock x:Name="PatHint" Text="" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== カテゴリ ===== -->
                <TabItem Header="🏷 カテゴリ">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CatAddBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="追加" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CatDelBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="選択行を削除" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <DataGrid x:Name="CategoriesGrid"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}"
                                  AlternatingRowBackground="#f8fafc" GridLinesVisibility="None"
                                  BorderBrush="{StaticResource Border}" BorderThickness="1"
                                  RowHeight="34" ColumnHeaderHeight="38" FontSize="13">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource Soft}"/>
                                    <Setter Property="Foreground" Value="{StaticResource SakuraD}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,4"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="コード" Binding="{Binding code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                <DataGridTextColumn Header="名称"   Binding="{Binding name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== 休業日 ===== -->
                <TabItem Header="🗓 休業日">
                    <DockPanel Margin="6">
                        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"
                                   Text="社内休業日を登録します。WBS ガントチャートで土日と同じ灰色で表示されます。日付は yyyy-MM-dd 形式。"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="HolAddBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="追加" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="HolDelBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="選択行を削除" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <DataGrid x:Name="HolidaysGrid"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}"
                                  AlternatingRowBackground="#f8fafc" GridLinesVisibility="None"
                                  BorderBrush="{StaticResource Border}" BorderThickness="1"
                                  RowHeight="34" ColumnHeaderHeight="38" FontSize="13">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource Soft}"/>
                                    <Setter Property="Foreground" Value="{StaticResource SakuraD}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,4"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="日付 (yyyy-MM-dd)" Binding="{Binding date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                <DataGridTextColumn Header="名称"               Binding="{Binding name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== 他者データ編集 ===== -->
                <TabItem Header="📝 他者データ編集">
                    <DockPanel Margin="6">
                        <Border DockPanel.Dock="Top" Background="{StaticResource Surface2}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="対象メンバー:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="OtherMemberCombo" MinWidth="240" Margin="6,0" DisplayMemberPath="display" SelectedValuePath="id"/>
                                <Label Content="年:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <ComboBox x:Name="OtherYearCombo" MinWidth="90" Margin="6,0"/>
                                <Label Content="月:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="OtherMonthCombo" MinWidth="60" Margin="6,0"/>
                                <Button x:Name="OtherReloadBtn" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA37;" Style="{StaticResource IconGlyph}"/>
                                        <TextBlock Text="読込" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="OtherStatusText" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="OtherAddBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="行追加" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="OtherDelBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="選択行削除" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="OtherSaveBtn" MinWidth="160">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="ローカル保存" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="OtherPushBtn" MinWidth="180">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE724;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="リモートへ送信" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <DataGrid x:Name="OtherEntriesGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  Background="{StaticResource Surface}"
                                  RowBackground="{StaticResource Surface}"
                                  AlternatingRowBackground="#f8fafc"
                                  GridLinesVisibility="None"
                                  BorderBrush="{StaticResource Border}"
                                  BorderThickness="1"
                                  RowHeight="32" ColumnHeaderHeight="36" FontSize="13"
                                  Margin="0,0,0,8">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource Soft}"/>
                                    <Setter Property="Foreground" Value="{StaticResource SakuraD}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,4"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="日付 (YYYY-MM-DD)" Binding="{Binding date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                                <DataGridTextColumn Header="プロジェクト"     Binding="{Binding project_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                <DataGridTextColumn Header="工程"             Binding="{Binding process_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="ﾀｽｸｸﾞﾙｰﾌﾟ"        Binding="{Binding task_group_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <DataGridTextColumn Header="タスク"           Binding="{Binding task_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <DataGridTextColumn Header="カテゴリ"         Binding="{Binding category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <DataGridTextColumn Header="工数"             Binding="{Binding hours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="70"/>
                                <DataGridTextColumn Header="コメント"         Binding="{Binding comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== JSON ===== -->
                <TabItem Header="🛠 JSON 直接編集">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <TextBlock Text="対象:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="JsonTargetCombo" Width="180">
                                <ComboBoxItem Content="members" IsSelected="True"/>
                                <ComboBoxItem Content="projects"/>
                                <ComboBoxItem Content="task_patterns"/>
                                <ComboBoxItem Content="categories"/>
                            </ComboBox>
                            <Button x:Name="JsonReloadBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA37;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="リロード" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="JsonValidateBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="JSON 検証" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="JsonApplyBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72A;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="編集内容に適用" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBox x:Name="JsonBox" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Courier New" FontSize="13"
                                 Background="#ffffff" Foreground="{StaticResource Text}"
                                 VerticalContentAlignment="Top" Margin="0,8,0,0"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>
    </DockPanel>
</Window>
