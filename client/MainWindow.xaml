<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WorkTime Tracker"
    Height="800" Width="1300"
    MinHeight="600" MinWidth="960"
    WindowStartupLocation="CenterScreen"
    Background="#0f172a"
    FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
    FontSize="13"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- 洗練されたディープスレート × エメラルドパレット -->
        <SolidColorBrush x:Key="Bg"        Color="#f8fafc"/>
        <SolidColorBrush x:Key="Surface"   Color="#ffffff"/>
        <SolidColorBrush x:Key="Surface2"  Color="#f1f5f9"/>
        <SolidColorBrush x:Key="Border"    Color="#cbd5e1"/>
        <SolidColorBrush x:Key="Text"      Color="#0f172a"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748b"/>
        <SolidColorBrush x:Key="Emerald"   Color="#047857"/>
        <SolidColorBrush x:Key="EmeraldD"  Color="#065f46"/>
        <SolidColorBrush x:Key="EmeraldL"  Color="#d1fae5"/>
        <SolidColorBrush x:Key="Soft"      Color="#ecfdf5"/>
        <SolidColorBrush x:Key="Sky"       Color="#0284c7"/>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
        </Style>

        <!-- 標準ボタン (ソフトグレー/ライトミント) -->
        <!-- ボタンアイコン用 (Segoe MDL2 Assets)。絵文字は環境によって色付き/モノクロが
             混在するため、アイコンとして使う箇所はこのグリフフォントに統一する -->
        <!-- ヘッダー/フッターの濃色地に置くボタン (すりガラス調)。取得/保存/送信/削除等の
             アクション種別による色分けを廃止し、全ボタンを同一の半透明チップ+縁取りに統一
             (2026-08-22 ユーザー要望: macOS の Toolbar/Vibrancy 材質を参考)。
             縁取りの不透明度はヘッダー背景 #0f172a に対し WCAG 1.4.11 (3:1 以上) を
             確保できる値まで上げてある (18% 程度では 1.7:1 までしか出ない実測済み) -->
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="BorderBrush" Value="#59FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#73FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#0AFFFFFF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="#64748b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#e2e8f0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#cbd5e1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#f1f5f9"/>
                                <Setter Property="Foreground" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>





        <!-- クイック工数ボタン -->
        <Style x:Key="QuickHour" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- カードコンテナ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource EmeraldD}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource Bg}">
        <!-- ===== ヘッダ (ディープスレート) ===== -->
        <Border DockPanel.Dock="Top" Background="#0f172a" Padding="18,12">
            <DockPanel>
                <!-- 右側: 画面切り替え & 管理機能ボタン群 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="WbsNavBtn" Margin="0,0,4,0" Style="{StaticResource HeaderButton}" ToolTip="WBS形式の実績入力画面を開く">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="WBS入力" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReportNavBtn" Margin="0,0,12,0" Style="{StaticResource HeaderButton}" ToolTip="集計レポート画面を開く">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="レポート" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="6,4" Background="#334155" VerticalAlignment="Stretch"/>
                    <Button x:Name="AdminBtn" Visibility="Collapsed" Style="{StaticResource HeaderButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="管理者" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UserPrefsBtn" Style="{StaticResource HeaderButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="お気に入り" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsBtn" Style="{StaticResource HeaderButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="設定" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 中央右: 年月選択 & 読込/取得 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="📅 表示" Foreground="#94a3b8" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="YearCombo" Width="84"/>
                    <TextBlock Text="/" Margin="4,0" Foreground="#94a3b8"/>
                    <ComboBox x:Name="MonthCombo" Width="64"/>
                    <Button x:Name="ReloadBtn" Margin="8,0,0,0" Style="{StaticResource HeaderButton}"
                            ToolTip="ローカルから当月データを再読込">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA37;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="読込" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PullBtn" Margin="4,0,0,0" Style="{StaticResource HeaderButton}"
                            ToolTip="Gitlab からマスタ + 当月個人実績を取得 → ローカルから読込">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="取得" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 左側: ログインユーザー & ステータス
                     DockPanel にして、長いメッセージは切り落としではなく "…" で省略する -->
                <DockPanel VerticalAlignment="Center">
                    <Border DockPanel.Dock="Left" Background="#1e293b" CornerRadius="20" Padding="14,6" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock x:Name="CurrentMemberText" Text="" FontWeight="Bold" FontSize="14" Foreground="#34d399"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Foreground="#fef08a" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="RemoteNoticeText" Visibility="Collapsed" Foreground="#fef08a" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- ===== フッタ (ディープスレート) ===== -->
        <Border DockPanel.Dock="Bottom" Background="#0f172a" Padding="18,12">
            <!-- Grid にしてボタン列 (Auto) を先に確保する。
                 local_store のパスが長くても、切れるのは左のテキスト側だけにする -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="ModeText" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock Grid.Column="1" x:Name="VersionText" Margin="12,0,12,0" Foreground="#34d399" FontSize="11" VerticalAlignment="Center"
                           Cursor="Hand" TextDecorations="Underline"
                           ToolTip="クリックで変更履歴 (CHANGELOG) を表示"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#1e293b" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅 選択日" Foreground="#94a3b8" Margin="0,0,8,0" FontWeight="Bold"/>
                            <TextBlock x:Name="HoursDayText" Text="0.0 h" FontWeight="Bold" FontSize="13" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1e293b" CornerRadius="8" Padding="12,6" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱ 月合計" Foreground="#94a3b8" Margin="0,0,8,0" FontWeight="Bold"/>
                            <TextBlock x:Name="HoursTotalText" Text="0.0 h" FontWeight="Bold" FontSize="16" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SaveBtn" MinWidth="100">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="保存" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar x:Name="SyncProgress" Width="120" Height="12" Margin="8,0,4,0" VerticalAlignment="Center"
                                 Visibility="Collapsed" IsIndeterminate="True" Foreground="#34d399"/>
                    <Button x:Name="PushBtn" MinWidth="100" Margin="6,2,3,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="送信" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenFolderBtn" Margin="6,2,3,2" Style="{StaticResource HeaderButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="開く" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 本体 (左: 当月実績 / 右: 入力フォーム) ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

            <!-- 左: 当月一覧 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ListTitle" Text="📋 当月エントリ一覧" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DuplicateBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="行を複製" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="EditRowBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="編集" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteRowBtn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="削除" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- 一覧とその空状態メッセージを重ねる。0 件のときに「次に何をするか」を案内する -->
                    <Grid>
                    <TextBlock x:Name="EmptyListText" Panel.ZIndex="1"
                               Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="24,60,24,0"
                               FontSize="13" Foreground="{StaticResource TextMuted}"
                               Text="この月の実績はまだありません。&#x0a;右のフォームから追加してください。"/>
                    <DataGrid x:Name="EntriesGrid"
                               AutoGenerateColumns="False"
                               IsReadOnly="True"
                               CanUserAddRows="False"
                               CanUserDeleteRows="False"
                               SelectionMode="Single"
                               SelectionUnit="FullRow"
                               HeadersVisibility="Column"
                               Background="{StaticResource Surface}"
                               Foreground="{StaticResource Text}"
                               RowBackground="{StaticResource Surface}"
                               AlternatingRowBackground="#f8fafc"
                               GridLinesVisibility="Horizontal"
                               HorizontalGridLinesBrush="#f1f5f9"
                               BorderBrush="{StaticResource Border}"
                               BorderThickness="1"
                               FontSize="13"
                               RowHeight="36"
                               ColumnHeaderHeight="38">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                <Setter Property="Foreground" Value="{StaticResource EmeraldD}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,4"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,4"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource EmeraldL}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <!-- 未保存行 (dirty='yes') は薄アンバー背景 + 左に橙ボーダー -->
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding dirty}" Value="yes">
                                        <Setter Property="Background" Value="#fffbeb"/>
                                        <Setter Property="BorderBrush" Value="#f59e0b"/>
                                        <Setter Property="BorderThickness" Value="4,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding dirty_mark}" Width="28" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#d97706"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="日付" Binding="{Binding date}" Width="100"/>
                            <DataGridTextColumn Header="案件名称" Binding="{Binding project_name}" Width="160"/>
                            <DataGridTextColumn Header="工程" Binding="{Binding process_name}" Width="90"/>
                            <DataGridTextColumn Header="タスクグループ" Binding="{Binding task_group_name}" Width="110"/>
                            <DataGridTextColumn Header="タスク" Binding="{Binding task_name}" Width="110"/>
                            <DataGridTextColumn Header="カテゴリ" Binding="{Binding category_name}" Width="90"/>
                            <DataGridTextColumn Header="工数" Binding="{Binding hours, StringFormat=N1}" Width="60"/>
                            <DataGridTextColumn Header="コメント" Binding="{Binding comment}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 右: 入力フォーム -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock x:Name="FormHeader" Text="✏ 新規エントリ" Style="{StaticResource SectionTitle}" DockPanel.Dock="Top"/>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="ClearBtn">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}"/>
                                <TextBlock Text="クリア" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="UpdateBtn" Visibility="Collapsed" MinWidth="100">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}"/>
                                <TextBlock Text="更新" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddBtn" MinWidth="100">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}"/>
                                <TextBlock Text="追加" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel>
                        <Label Content="日付  (バックデートOK)" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PrevDayBtn" Content="◀" MinWidth="32" Margin="0,1,2,1" MinHeight="26" ToolTip="前日 (-1日)"/>
                            <DatePicker x:Name="EntryDate" Width="140"/>
                            <Button x:Name="NextDayBtn" Content="▶" MinWidth="32" Margin="2,1,4,1" MinHeight="26" ToolTip="翌日 (+1日)"/>
                            <Button x:Name="TodayBtn" MinWidth="58" Margin="2,1,0,1" MinHeight="26" Padding="4,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="今日" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="YesterdayBtn" MinWidth="58" Margin="2,1,0,1" MinHeight="26" Padding="4,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" Style="{StaticResource IconGlyph}"/>
                                    <TextBlock Text="昨日" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <CheckBox x:Name="IsLeaveChk" Content="🏖 休暇 (プロジェクト/工程/タスク不要)"
                                  Margin="0,10,0,4" FontWeight="SemiBold"
                                  ToolTip="ON にすると有給休暇/半休/特別休暇 等を記録できます。プロジェクト等の選択は不要になります"/>

                        <Label Content="プロジェクト (ユニット)" Margin="0,4,0,0"/>
                        <ComboBox x:Name="ProjectCombo" DisplayMemberPath="display" SelectedValuePath="unit_code"
                                  IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                  TextSearch.TextPath="display"/>

                        <Label Content="工程" Margin="0,3,0,0"/>
                        <ComboBox x:Name="ProcessCombo" DisplayMemberPath="name" SelectedValuePath="code"/>

                        <Label Content="タスクグループ" Margin="0,3,0,0"/>
                        <ComboBox x:Name="TaskGroupCombo" DisplayMemberPath="name" SelectedValuePath="code"/>

                        <Label Content="タスク" Margin="0,3,0,0"/>
                        <ComboBox x:Name="TaskCombo" DisplayMemberPath="name" SelectedValuePath="code"/>

                        <Border x:Name="TaskDescBorder" Margin="0,4,0,0" Padding="8,6" CornerRadius="4"
                                Background="#fffbeb" BorderBrush="#fcd34d" BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TaskDescText" TextWrapping="Wrap" FontSize="11" Foreground="#92400e"/>
                        </Border>

                        <Label Content="作業カテゴリ" Margin="0,4,0,0"/>
                        <ComboBox x:Name="CategoryCombo" DisplayMemberPath="name" SelectedValuePath="code"/>

                        <Label Content="工数 (時間)" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HoursBox" Text="1.0" FontSize="16" FontWeight="Bold" Width="76"/>
                            <Button x:Name="H025" Content="0.25" Style="{StaticResource QuickHour}" Tag="0.25" Margin="3,1,1,1"/>
                            <Button x:Name="H05"  Content="0.5"  Style="{StaticResource QuickHour}" Tag="0.5"  Margin="2,1"/>
                            <Button x:Name="H1"   Content="1"    Style="{StaticResource QuickHour}" Tag="1"    Margin="2,1"/>
                            <Button x:Name="H2"   Content="2"    Style="{StaticResource QuickHour}" Tag="2"    Margin="2,1"/>
                            <Button x:Name="H4"   Content="4"    Style="{StaticResource QuickHour}" Tag="4"    Margin="2,1"/>
                            <Button x:Name="H8"   Content="8"    Style="{StaticResource QuickHour}" Tag="8"    Margin="2,1"/>
                        </StackPanel>

                        <Label Content="コメント (任意)" Margin="0,4,0,0"/>
                        <TextBox x:Name="CommentBox" Height="52" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
